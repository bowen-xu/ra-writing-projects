+    constructor(createRow) {
+        this.createRow = createRow;
+        this.cache = [];
+        this.transactionNodesPendingRemoval = new Set();
+        this.inTransaction = false;
+    }
+    alloc() {
+        let result = this.cache.pop();
+        if (result) this.transactionNodesPendingRemoval.delete(result);
+        else result = this.createRow();
+        return result;
+    }
+    release(row) {
+        if (this.inTransaction) this.transactionNodesPendingRemoval.add(row);
+        else row.remove();
+        this.cache.push(row);
+    }
+    transact(makeChanges) {
+        if (this.inTransaction) throw new Error("Already in transaction");
+        this.inTransaction = true;
+        try { makeChanges(); }
+        finally {
+            for (const node of this.transactionNodesPendingRemoval) node.remove();
+            this.transactionNodesPendingRemoval.clear();
+            this.inTransaction = false;
+        }
+    }
+    dispose() {
+        this.cache.length = 0;
+        this.transactionNodesPendingRemoval.clear();
+    }
